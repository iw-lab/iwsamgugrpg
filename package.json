{
  "name": "yungkuljun-game",
  "version": "0.1.0",
  "private": true,
  "description": "한조재흥기 - 유비 중심 턴제 SRPG (Phaser 3 + TypeScript)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\""
  },
  "dependencies": {
    "howler": "^2.2.4",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^25.6.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.2",
    "vitest": "^4.1.4"
  },
  "packageManager": "pnpm@10.33.0"
}
